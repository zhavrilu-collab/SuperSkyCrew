APP_NAME="HR SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8004
APP_FORCE_HTTPS=false

APP_LOCALE=hr
APP_FALLBACK_LOCALE=hr
APP_FAKER_LOCALE=hr_HR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hr_saas
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Produkcija iza reverse proxyja (nginx): TRUSTED_PROXIES=*
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin konzola sync (isti ključ kao SAAS_WEBHOOK_SECRET u Core-u)
ADMIN_SYNC_API_KEY=dev-sync-key-change-me
ADMIN_CONSOLE_API_URL=http://127.0.0.1:8001
ADMIN_CONSOLE_APPLICATION_SLUG=hr-saas
ADMIN_CONSOLE_WEBHOOK_SECRET=dev-sync-key-change-me
ADMIN_CONSOLE_WEBHOOK_URL=http://127.0.0.1:8001/api/webhooks/tenants/registered
ADMIN_CONSOLE_HTTP_VERIFY=true
ADMIN_CONSOLE_HTTP_RESOLVE_LOOPBACK=false

# Core identity (Faza B/D)
IDENTITY_CORE_AUTH_ENABLED=true
IDENTITY_CORE_API_URL=http://127.0.0.1:8001
IDENTITY_CORE_API_VERSION=v1
IDENTITY_GOOGLE_OAUTH_ENABLED=false
IDENTITY_MICROSOFT_OAUTH_ENABLED=false
IDENTITY_UNIFIED_LOGIN_ENABLED=false

# Sudski registar — uživo REST (https://sudreg-data.gov.hr). Besplatna registracija daje Client ID/Secret.
SUDREG_CLIENT_ID=
SUDREG_CLIENT_SECRET=
# NKZ_DUMP_URL=http://web.dzs.hr/App/klasus/Download/GenericFillerFrm.aspx?id=1221980&parent=ClassificationVersion&content=ClassificationItems&action=downloadJson
# SUDREG_BASE_URL=https://sudreg-data.gov.hr/api/javni
# SUDREG_TOKEN_URL=https://sudreg-data.gov.hr/api/oauth/token

# Probni period nakon odobrenja tenanta
# HR_TRIAL_DAYS=14
# HR_TRIAL_PLAN=standard
# HR_TRIAL_FALLBACK_PLAN=basic

# Produkcija (isti VPS kao konzola):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://hr.superskytech.com
# APP_FORCE_HTTPS=true
# DB_CONNECTION=mysql
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# TRUSTED_PROXIES=*
# ADMIN_CONSOLE_HTTP_RESOLVE_LOOPBACK=true

